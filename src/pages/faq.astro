---
import Base from '../layouts/Base.astro';
import { FAQS } from '../data/faqs';

const strip = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&gt;/g, '>').replace(/&lt;/g, '<').replace(/&amp;/g, '&');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.flatMap((g) =>
    g.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: strip(f.a) } }))
  ),
};
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<Base title="FAQ · QToys Docs" description="Answers to common questions about setting up, customizing and updating the QToys Shopify theme.">
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <section class="wrap page-head">
    <div class="spec"><span class="dot"></span>FAQ</div>
    <h1>Frequently asked <span class="it">questions</span></h1>
    <p>Quick answers about QToys. Can’t find yours? <a href="/support">Contact support</a>.</p>
    <nav class="faq-topics" aria-label="Topics">
      {FAQS.map((g) => <a href={`#${slug(g.topic)}`}>{g.topic}</a>)}
    </nav>
  </section>

  <section class="wrap faq" data-pagefind-body>
    {FAQS.map((g) => (
      <section class="faq-group" id={slug(g.topic)}>
        <h2>{g.topic}</h2>
        {g.items.map((f) => (
          <details class="faq-item">
            <summary><span>{f.q}</span><span class="faq-ic" aria-hidden="true" /></summary>
            <div class="faq-a prose" set:html={`<p>${f.a}</p>`} />
          </details>
        ))}
      </section>
    ))}

    <aside class="faq-cta">
      <div>
        <h2>Still need help?</h2>
        <p>Send us your question with your store URL and a screenshot. We reply within two business days.</p>
      </div>
      <a class="cta" href="/support">Contact support <span>→</span></a>
    </aside>
  </section>
</Base>

<style>
  .page-head { max-width:760px; padding-top:64px; padding-bottom:28px; }
  .faq { max-width:760px; padding-bottom:72px; display:flex; flex-direction:column; gap:40px; }
  .faq-topics { display:flex; flex-wrap:wrap; gap:8px; margin-top:24px; }
  .faq-topics a { font-size:14px; padding:7px 14px; border-radius:999px; border:1px solid var(--line); color:var(--ink-2); background:#fff; transition:all .15s var(--ease); }
  .faq-topics a:hover { border-color:var(--accent-line); background:var(--accent-soft); color:var(--accent-ink); }
  .faq-group { scroll-margin-top:calc(var(--header) + 20px); }
  .faq-group h2 { font-size:22px; font-weight:800; letter-spacing:-.03em; margin:0 0 12px; }
  .faq-item { border-top:1px solid var(--line); }
  .faq-item:last-child { border-bottom:1px solid var(--line); }
  .faq-item summary { list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:16px; padding:16px 2px; font-weight:600; font-size:16px; color:var(--ink); }
  .faq-item summary::-webkit-details-marker { display:none; }
  .faq-ic { position:relative; flex:none; width:14px; height:14px; }
  .faq-ic::before, .faq-ic::after { content:""; position:absolute; left:0; top:6px; width:14px; height:2px; border-radius:2px; background:var(--accent-ink); transition:transform .2s var(--ease); }
  .faq-ic::after { transform:rotate(90deg); }
  .faq-item[open] .faq-ic::after { transform:rotate(0deg); }
  .faq-a { padding:0 2px 18px; font-size:15.5px; }
  .faq-cta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px; padding:24px; border-radius:16px; background:var(--accent-soft); border:1px solid var(--accent-line); }
  .faq-cta h2 { font-size:20px; font-weight:800; letter-spacing:-.02em; margin:0; }
  .faq-cta p { margin:6px 0 0; color:var(--ink-2); font-size:15px; }
</style>
