---
import '../styles/global.css';
import { theme, logo, site } from '../config';
import { loadDocs } from '../lib/docs';
import Search from '../components/Search.astro';
import SearchDialog from '../components/SearchDialog.astro';
const { title, description } = Astro.props as { title?: string; description?: string };
const t = theme();
const pageTitle = title ?? `${t.brand} ${site.guideLabel}`;
const pageDescription = description ?? site.tagline;
const vars = `--accent:${t.accent};--accent-ink:${t.accentInk};--accent-soft:${t.accentSoft};`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const path = Astro.url.pathname;
const docsHome = (await loadDocs())[0]?.url ?? '/docs';
const nav = [
  { href: docsHome, label: 'Docs', on: path.startsWith('/docs') },
  { href: '/faq', label: 'FAQ', on: path.startsWith('/faq') },
  { href: '/support', label: 'Support', on: path.startsWith('/support') },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" style={vars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/inter-vf-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label={`${t.brand} ${site.guideLabel} home`}>
          <Fragment set:html={logo(28)} />
          <span>{t.brand}</span><span class="tag">{site.guideLabel}</span>
        </a>
        <nav class="hlinks" aria-label="Main">
          <Search />
          {nav.map((n) => <a href={n.href} class={n.on ? 'on' : ''} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
          <a href={site.homeUrl} target="_blank" rel="noopener">{site.demoLabel} ↗</a>
        </nav>
        <details class="mmenu">
          <summary aria-label="Menu">
            <svg viewBox="0 0 20 20" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M3 6h14M3 10h14M3 14h14" /></svg>
          </summary>
          <div class="mmenu-panel">
            <button type="button" class="mmenu-search" data-search-open>
              <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="9" r="6.5" /><path d="M18 18l-4.3-4.3" /></svg>
              Search docs
            </button>
            {nav.map((n) => <a href={n.href} aria-current={n.on ? 'page' : undefined}>{n.label}</a>)}
            <a href={site.homeUrl} target="_blank" rel="noopener">{site.demoLabel} ↗</a>
          </div>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="sfoot">
      <div class="wrap sfoot-in">
        <div class="sfoot-brand">
          <Fragment set:html={logo(22)} />
          <span>{t.brand} — a Shopify theme by QDN</span>
        </div>
        <nav class="sfoot-links" aria-label="Footer">
          <a href={docsHome}>Docs</a>
          <a href="/faq">FAQ</a>
          <a href="/support">Contact support</a>
          <a href="/docs/support/support-policy">Support policy</a>
          <a href="/docs/support/release-notes">Release notes</a>
        </nav>
        <p class="sfoot-fine">© {year} QDN. Shopify is a trademark of Shopify Inc.</p>
      </div>
    </footer>
    <SearchDialog />
    <script src="https://qdn.qone.work/widget.js" data-product="fp_24c1b1351a3374b90f1df212" async></script>
  </body>
</html>
